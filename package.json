{
  "name": "chat-state-dynamodb",
  "version": "0.1.0",
  "description": "DynamoDB state adapter for Chat SDK: thread subscriptions, distributed locks and caching on a single table, no Redis, no VPC",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@12.5.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "dynamodb:up": "docker run -d --rm --name chat-state-dynamodb -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "dynamodb:down": "docker stop chat-state-dynamodb",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": ">=3.600.0",
    "@aws-sdk/lib-dynamodb": ">=3.600.0",
    "chat": ">=4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1136.0",
    "@aws-sdk/lib-dynamodb": "3.1136.0",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.2",
    "chat": "4.41.0",
    "executable-stories-vitest": "8.9.6",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "keywords": [
    "chat-sdk",
    "chat",
    "state-adapter",
    "dynamodb",
    "aws",
    "slack",
    "bot",
    "lambda"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/chat-state-dynamodb.git"
  },
  "homepage": "https://github.com/jagreehal/chat-state-dynamodb#readme",
  "bugs": "https://github.com/jagreehal/chat-state-dynamodb/issues",
  "author": "Jag Reehal <jag@jagreehal.com>",
  "license": "MIT"
}
